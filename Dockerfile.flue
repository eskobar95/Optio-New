# flue — Optio-New agent harness sidecar stub (Compose profile: flue)
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.flue.json ./
RUN npm ci
COPY src/flue ./src/flue
COPY src/adapters/flue/contract.ts ./src/adapters/flue/contract.ts
RUN npx tsc -p tsconfig.flue.json

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV FLUE_PORT=3220
COPY package.json package-lock.json ./
# prepare runs husky (devDependency). Ignore scripts so prod install works without it.
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --from=build /app/dist ./dist
USER node
EXPOSE 3220
CMD ["node", "dist/flue/main.js"]
