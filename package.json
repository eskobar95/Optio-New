{
  "name": "@optio-new/harness",
  "version": "0.0.1",
  "private": true,
  "description": "Optio-New — TypeScript self-hosted coding-agent factory (BullMQ pipeline, New Bot decision layer, Cursor skills)",
  "language": "typescript",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build:orchestrator": "tsc -p tsconfig.orchestrator.json",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "bash scripts/smoke-local.sh",
    "smoke:compose": "bash scripts/smoke-compose-mac.sh",
    "status": "bash scripts/update-status.sh",
    "kit-harness": "tsc -p tsconfig.kit-harness.json && node dist/main.js",
    "eval": "vitest run tests/eval/harness-eval.test.ts",
    "eval:live": "HARNESS_EVAL_LIVE=1 vitest run tests/eval/harness-eval.test.ts",
    "learn-worker": "tsc -p tsconfig.learning-worker.json && node dist/main.js",
    "eve-runner": "tsc -p tsconfig.eve.json && node dist/src/eve/cli.js",
    "jev-mcp": "tsc -p tsconfig.jev-mcp.json && node dist/src/jev-mcp/main.js",
    "optio-api": "tsc -p tsconfig.orchestrator.json && node dist/src/api/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run smoke"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "bullmq": "^5.34.0",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^5.4.2",
    "pg": "^8.23.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
