# Optio-New — environment template (no real secrets)
# Copy to `.env` for local use. `.env` is gitignored.
# Hetzner kit-harness (/opt/optio-new): encrypt with sops+age. See docs/secrets.md.
# OPTIO_NEW_* is the harness prefix. MODEL_* feeds the model adapter.
# LiteLLM reads LITELLM_MASTER_KEY, OPENAI_API_KEY, and ANTHROPIC_API_KEY.

# --- Model adapter (agent loop / CodingAgent) ---
MODEL_API_KEY=
MODEL_ENDPOINT=

# --- Core ---
OPTIO_NEW_ENV=development
# Loopback HTTP is the local/dev intake. IP HTTP edge does not read these.
# Set the host and ACME email only for a later domain + TLS Caddyfile.
# See docs/ops/caddy-tls-edge.md.
OPTIO_NEW_WEBHOOK_HOST=localhost
OPTIO_NEW_ACME_EMAIL=

# --- Postgres ---
OPTIO_NEW_POSTGRES_USER=optio
OPTIO_NEW_POSTGRES_PASSWORD=changeme
OPTIO_NEW_POSTGRES_DB=optio_new
OPTIO_NEW_DATABASE_URL=postgres://optio:changeme@127.0.0.1:5432/optio_new

# --- Redis / BullMQ ---
OPTIO_NEW_REDIS_URL=redis://127.0.0.1:6379

# Orchestrator intake HTTP. Compose publishes it on 127.0.0.1:3100.
ORCHESTRATOR_PORT=3100

# Host bind ports for docker-compose.yml (loopback). Defaults match the file.
# scripts/smoke-compose-mac.sh overrides these on project optio-new-mac-smoke.
# OPTIO_NEW_REDIS_HOST_PORT=6379
# OPTIO_NEW_POSTGRES_HOST_PORT=5432
# OPTIO_NEW_LITELLM_HOST_PORT=4000

# --- Jev via Vercel AI Gateway (v1; not TypeSafe direct) ---
# Also the optional advisor URL for kit-harness. v0 rules engine does not call it.
# GET /health sets jev_configured when JEV_BASE_URL is non-empty.
JEV_BASE_URL=https://ai-gateway.vercel.sh
VERCEL_AI_GATEWAY_URL=https://ai-gateway.vercel.sh
OPTIO_NEW_JEV_BASE_URL=https://ai-gateway.vercel.sh
OPTIO_NEW_VERCEL_AI_GATEWAY_URL=https://ai-gateway.vercel.sh
OPTIO_NEW_JEV_API_KEY=
# Hop 2 plugin id: jev | poorjev | laya | rules. The loader fails closed when this is unset.
OPTIO_NEW_JEV_ROUTER=rules

# --- Optional Laya (Compose profile: laya). Off unless `--profile laya`. ---
# Placeholder on 127.0.0.1:8000. CPU only. NVIDIA Container Toolkit is not required.
# See docs/laya.md. Leave LAYA_API_KEY unset in git; set it only on the host.
OPTIO_NEW_LAYA_URL=http://127.0.0.1:8000
LAYA_DEVICE=cpu
LAYA_PRELOAD=0
LAYA_THREADS=4
# OPTIO_NEW_LAYA_HOST_PORT=8000

# --- LiteLLM (gateway reads these names) ---
LITELLM_MASTER_KEY=sk-change-me
# Origin only (no /v1). Codex uses ${LITELLM_BASE_URL}/v1 when the Caveman proxy is off.
LITELLM_BASE_URL=http://127.0.0.1:4000
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- kit-harness decision sidecar (Compose profile: harness) ---
# Loopback only. No public DNS. Host publish is 127.0.0.1:${KIT_HARNESS_PORT}.
KIT_HARNESS_PORT=3200
OPTIO_NEW_HARNESS_URL=http://127.0.0.1:3200

# --- New Bot intake (optional HTTP enqueue) ---
OPTIO_NEW_INTAKE_WEBHOOK_SECRET=

# --- GitHub ---
OPTIO_NEW_GITHUB_WEBHOOK_SECRET=
OPTIO_NEW_GITHUB_TOKEN=
# owner/repo for ready/open_pr. Empty fails that step with a credentials error.
OPTIO_NEW_GITHUB_REPO=
# Branch worktrees are cut from and pull requests target.
OPTIO_NEW_BASE_BRANCH=development
# Multi-repo catalog. Empty OPTIO_NEW_REPOS keeps one default checkout.
# OPTIO_NEW_REPOS is a JSON array: repoId, cloneUrl, localPath, defaultBranch, worktreeRoot.
OPTIO_NEW_REPO_CLONE_URL=
OPTIO_NEW_DEFAULT_REPO_ID=default
OPTIO_NEW_REPOS=
# Slack slash command / app mention. Blank fails POST /webhooks/slack closed (503).
OPTIO_NEW_SLACK_SIGNING_SECRET=

# --- Learning worker (Compose profile: learn) ---
# Threshold hit opens a GitHub meta-issue when TOKEN and GITHUB_REPO are set.
# FILE_GITHUB=0 stores the draft and does not call GitHub.
OPTIO_LEARN_THRESHOLD=3
OPTIO_LEARN_WINDOW_DAYS=14
OPTIO_LEARN_FILE_GITHUB=
OPTIO_LEARN_GITHUB_REPO=

# --- Cursor CLI (subscription) ---
CURSOR_API_KEY=

# --- Backups (Hetzner Storage Box). Runbook: docs/ops/postgres-storagebox-backup.md ---
# Mode auto picks restic, then borg. Set sftp or rsync for a plain pg_dump upload.
# OPTIO_NEW_BACKUP_REPO examples (placeholders, not an account):
#   sftp:storagebox:backups/optio-new
#   ssh://uXXXXX@uXXXXX.your-storagebox.de:23/./backups/optio-new
OPTIO_NEW_BACKUP_MODE=auto
OPTIO_NEW_BACKUP_REPO=
OPTIO_NEW_BACKUP_PASSWORD=
OPTIO_NEW_BACKUP_SSH_HOST=
OPTIO_NEW_BACKUP_SSH_USER=
OPTIO_NEW_BACKUP_SSH_PORT=23
OPTIO_NEW_BACKUP_SSH_KEY_PATH=
OPTIO_NEW_BACKUP_SSH_KNOWN_HOSTS=
OPTIO_NEW_BACKUP_REMOTE_DIR=backups/optio-new/postgres
OPTIO_NEW_BACKUP_SFTP_COMMAND=
OPTIO_NEW_BACKUP_BORG_REMOTE_PATH=
OPTIO_NEW_BACKUP_KEEP_DAILY=7
OPTIO_NEW_BACKUP_KEEP_WEEKLY=4
OPTIO_NEW_BACKUP_KEEP_MONTHLY=6
OPTIO_NEW_BACKUP_ALERT_WEBHOOK=

# --- Parallel coding sessions (SPEC §13.5) ---
# Max concurrent Cursor CLI runs (N) and Codex CLI runs (M). 0 rejects that provider.
OPTIO_NEW_CURSOR_MAX_CONCURRENCY=1
OPTIO_NEW_CODEX_MAX_CONCURRENCY=1
# queue (oldest task first) or reject (rate_limited, nothing queued)
OPTIO_NEW_SESSION_OVERFLOW=queue
# Host checkout mounted into the orchestrator. Compose default is /opt/optio-new.
OPTIO_NEW_REPO_PATH=/opt/optio-new
OPTIO_NEW_WORKTREE_ROOT=/var/lib/optio-new/worktrees
# true keeps wt-<task> when merge fails. false removes that named directory.
OPTIO_NEW_WORKTREE_RETAIN_ON_FAILURE=true
# CX33 guard checked before worktree create. Counts only; not secrets.
OPTIO_NEW_MIN_FREE_DISK_BYTES=2147483648
OPTIO_NEW_MIN_FREE_INODES=10000
OPTIO_NEW_MIN_AVAILABLE_MEMORY_BYTES=536870912
OPTIO_NEW_DOCKER_DATA_ROOT=/var/lib/docker

# --- Human approval (docs/hitl.md). Blank uses workflows/default-task.yaml. ---
# plan: off | when_confidence_low | always. merge: same. Timeout never auto-approves.
OPTIO_HITL_PLAN=
OPTIO_HITL_MERGE=
OPTIO_HITL_CONFIDENCE_THRESHOLD=0.8
OPTIO_HITL_TIMEOUT_MS=86400000
OPTIO_HITL_POLL_MS=60000

# --- Per-task spend caps (docs/task-budget.md). Blank uses the workflow YAML. ---
# Defaults: 200000 tokens and USD 2, sized for a CX33 host and Vercel AI Gateway.
OPTIO_TASK_MAX_TOKENS=200000
OPTIO_TASK_MAX_USD=2

# --- OpenTelemetry (default OFF; only the string true enables an exporter) ---
# Agent UI: Langfuse. Phoenix is not wired. Infra OTLP: SigNoz. See docs/observability.md.
OPTIO_OTEL_LANGFUSE=false
OPTIO_OTEL_SIGNOZ=false
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OPTIO_LANGFUSE_OTLP_ENDPOINT=
OPTIO_SIGNOZ_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces

# --- Optional Caveman local proxy (cost-opt; default OFF) ---
# MIT skills: .cursor/skills/caveman* — /caveman and /caveman off do not start the proxy.
# Do not vendor the BSL binary. Install the MIT CLI on the host:
#   npm i -g @caveman-ai/cli && caveman setup --install
# Merge gateway/caveman/caveman.yaml.example into ~/.caveman/caveman.yaml
# Start (no Platform/Cloud account):
#   CAVEMAN_MODE=compress CAVE_SSRF_ALLOWLIST=127.0.0.1 caveman start
# Only the string "true" enables. Codex base_url then becomes
#   http://127.0.0.1:8787/compat/litellm/v1
# Steps: src/proxy/README.md
CAVEMAN_PROXY_ENABLED=false
CAVEMAN_PROXY_URL=http://127.0.0.1:8787
CAVEMAN_MODE=compress
# CAVE_SSRF_ALLOWLIST=127.0.0.1
