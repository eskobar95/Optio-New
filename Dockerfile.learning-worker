# Learning worker — BullMQ consumer for optio.learn (Compose profile: learn)
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.learning-worker.json ./
RUN npm ci
COPY src/orchestrator/learning ./src/orchestrator/learning
RUN npx tsc -p tsconfig.learning-worker.json

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
# prepare runs husky (devDependency). Ignore scripts so prod install works without it.
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --from=build /app/dist ./dist
COPY state/migrations/002_learnings.sql ./state/migrations/002_learnings.sql
USER node
CMD ["node", "dist/main.js"]
