# LiteLLM Proxy — Optio-New model_list placeholder (SPEC §14.2)
# Copy to config.yaml and fill via sops/Infisical; never commit real keys.

model_list:
  - model_name: gpt-4o
    litellm_params:
      model: openai/gpt-4o
      api_key: os.environ/OPENAI_API_KEY
  - model_name: claude-sonnet
    litellm_params:
      model: anthropic/claude-sonnet-4-20250514
      api_key: os.environ/ANTHROPIC_API_KEY
  # - model_name: cache-exact
  #   litellm_params:
  #     model: ...

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
