# LiteLLM Proxy — Optio-New example model_list (SPEC §14.2)
# Copy to config.yaml (gitignored). Keys come from the sops+age env. See docs/secrets.md.
#
# Hop 2 (subscription_pool | alt_api | cache | deny) is decided by the TypeScript
# JevRouter before this proxy: loadHop2Router + applyHop2Decision.
# See gateway/jev-router/README.md. LiteLLM custom_router hooks are Python, so
# they are not the v1 plugin host.
# cache: the harness returns the stored completion (zero upstream tokens).
# deny: the harness returns HTTP 429. The local cache below is the exact-prompt
# backend for calls that are forwarded.

model_list:
  - model_name: gpt-4o
    litellm_params:
      model: openai/gpt-4o
      api_key: os.environ/OPENAI_API_KEY
  - model_name: claude-sonnet
    litellm_params:
      model: anthropic/claude-sonnet-4-20250514
      api_key: os.environ/ANTHROPIC_API_KEY
  - model_name: cache-exact
    litellm_params:
      model: openai/gpt-4o
      api_key: os.environ/OPENAI_API_KEY

litellm_settings:
  cache: true
  cache_params:
    type: local

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
