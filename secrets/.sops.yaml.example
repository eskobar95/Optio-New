# Optio-New — sops + age example (SPEC §12.5)
# Copy to secrets/.sops.yaml and set your age recipients. Never commit decrypted secrets.

creation_rules:
  - path_regex: \.env$
    encrypted_regex: '^(OPTIO_NEW_|JEV_|VERCEL_|LITELLM_|OPENAI_|ANTHROPIC_|LINEAR_|GITHUB_|CURSOR_|POSTGRES_|DATABASE_).*$'
    age: >-
      age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
