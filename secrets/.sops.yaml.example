# Copy to secrets/.sops.yaml (gitignored) or run: bash scripts/secrets.sh init
# Replace the recipient with the age public key:
#   age-keygen -y /opt/optio-new/secrets/age/key.txt
# The private key stays on the host. Do not commit it.
creation_rules:
  - path_regex: (^|/)optio-new\.env$
    age: AGE_RECIPIENT_REPLACE_ME
