# Optio-New — environment template (no real secrets)
# Env prefix: OPTIO_NEW_ (aliases documented for Jev / Vercel AI Gateway)

# --- Core ---
OPTIO_NEW_ENV=development
OPTIO_NEW_WEBHOOK_HOST=localhost

# --- Postgres ---
OPTIO_NEW_POSTGRES_USER=optio
OPTIO_NEW_POSTGRES_PASSWORD=changeme
OPTIO_NEW_POSTGRES_DB=optio_new
OPTIO_NEW_DATABASE_URL=postgres://optio:changeme@127.0.0.1:5432/optio_new

# --- Redis / BullMQ ---
OPTIO_NEW_REDIS_URL=redis://127.0.0.1:6379

# --- Jev via Vercel AI Gateway (v1; NOT TypeSafe direct) ---
JEV_BASE_URL=https://ai-gateway.vercel.sh
VERCEL_AI_GATEWAY_URL=https://ai-gateway.vercel.sh
OPTIO_NEW_JEV_BASE_URL=https://ai-gateway.vercel.sh
OPTIO_NEW_VERCEL_AI_GATEWAY_URL=https://ai-gateway.vercel.sh
# OPTIO_NEW_JEV_API_KEY=

# --- Optional Laya (compose profile: laya) ---
OPTIO_NEW_LAYA_URL=http://127.0.0.1:8000
LAYA_DEVICE=cpu
LAYA_PRELOAD=1

# --- LiteLLM ---
LITELLM_MASTER_KEY=sk-change-me
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- New Bot intake (optional HTTP enqueue) ---
# OPTIO_NEW_INTAKE_WEBHOOK_SECRET=

# --- GitHub ---
# OPTIO_NEW_GITHUB_WEBHOOK_SECRET=
# OPTIO_NEW_GITHUB_TOKEN=

# --- Cursor CLI (subscription) ---
# CURSOR_API_KEY=

# --- Backups (restic/borg → Hetzner Storage Box) ---
# OPTIO_NEW_BACKUP_REPO=
# OPTIO_NEW_BACKUP_PASSWORD=

# LiteLLM origin (no /v1). Used when CAVEMAN_PROXY_ENABLED is false.
# LITELLM_BASE_URL=http://127.0.0.1:4000

# Optional Caveman local proxy (default off). No Platform/Cloud.
# Host only: npm i -g @caveman-ai/cli && caveman setup --install
#   CAVEMAN_MODE=compress CAVE_SSRF_ALLOWLIST=127.0.0.1 caveman start
# See gateway/caveman/caveman.yaml.example and src/proxy/README.md
# CAVEMAN_PROXY_ENABLED=false
# CAVEMAN_PROXY_URL=http://127.0.0.1:8787
# CAVEMAN_MODE=compress
# CAVE_SSRF_ALLOWLIST=127.0.0.1
