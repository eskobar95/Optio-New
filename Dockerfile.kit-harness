# kit-harness — Optio-New decision sidecar (Compose profile: harness)
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.kit-harness.json ./
RUN npm ci
COPY src/kit-harness ./src/kit-harness
RUN npx tsc -p tsconfig.kit-harness.json

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV KIT_HARNESS_PORT=3200
COPY package.json package-lock.json ./
# prepare runs husky (devDependency). Ignore scripts so prod install works without it.
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --from=build /app/dist ./dist
USER node
EXPOSE 3200
CMD ["node", "dist/main.js"]
