# Optio-New Eve runner — intentional stub.
#
# agents/{planner,implementation,review,ready,merge}/ are Eve slots
# (agent.ts policy stub, instructions.md, tools/, skills/ refs).
# Nothing in this repo starts an Eve session as a process.
# Intake HTTP and the BullMQ stage graph run in the orchestrator image
# (Dockerfile.orchestrator). Do not point this service at that server: Compose
# keeps eve-runner separate, and a second listener on :3100 would collide.
#
# Replace the CMD below when an Eve process entrypoint lands in-repo.

FROM node:22-alpine
WORKDIR /app
COPY package.json ./
RUN echo "eve-runner intentional stub — agents/ has no process entrypoint"
CMD ["node", "-e", "console.log('optio-new eve-runner intentional stub (no process entrypoint in agents/)'); setInterval(()=>{}, 1e9)"]
