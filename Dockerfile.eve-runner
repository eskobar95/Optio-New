# Local eve-runner (HTTP). Not Vercel Workflows.
# agents/* and specialists/* stay Eve slots. This process loads them, seeds the
# workflow skill budget via createWorkflowSkillLoader, and runs one CodingAgent step.
# It does not advance the BullMQ graph.
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json tsconfig.json tsconfig.eve.json ./
ENV HUSKY=0
RUN npm ci
COPY src ./src
COPY agents ./agents
COPY skills ./skills
COPY specialists ./specialists
COPY workflows ./workflows
COPY .cursor/skills ./.cursor/skills
COPY .cursor/agents ./.cursor/agents
RUN npx tsc -p tsconfig.eve.json && npm prune --omit=dev
ENV EVE_RUNNER_HOST=0.0.0.0
ENV EVE_RUNNER_PORT=3200
EXPOSE 3200
USER node
CMD ["node", "dist/src/eve/cli.js", "serve"]
