# Optio-New — Compose on boot via sops+age (SPEC §12.5, docs/secrets.md)
# Install:
#   sudo cp deploy/systemd/optio-new-compose.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now optio-new-compose.service
# The helper decrypts to a mode-0600 tmpfs file. Do not add EnvironmentFile:
# systemd would expose those values through systemctl show.

[Unit]
Description=Optio-New Docker Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/optio-new
Environment=SOPS_AGE_KEY_FILE=/opt/optio-new/secrets/age/key.txt
ExecStart=/opt/optio-new/scripts/secrets.sh compose up -d
ExecStop=/usr/bin/docker compose -f /opt/optio-new/docker-compose.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
