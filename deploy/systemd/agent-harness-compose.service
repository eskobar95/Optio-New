# Optio-New — same boot unit as optio-new-compose.service (historical filename).
# Install one of them, not both. Decrypt path: docs/secrets.md.
#   sudo cp deploy/systemd/agent-harness-compose.service /etc/systemd/system/optio-new-compose.service
# The helper decrypts to a mode-0600 tmpfs file. Do not add EnvironmentFile.
# COMPOSE_PROFILES matches optio-new-compose.service. Profile edge stays off.
# Optional drop-in: docs/ops/caddy-tls-edge.md. See deploy/README.md.

[Unit]
Description=Optio-New Docker Compose stack (litellm, harness, orchestrator)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/optio-new
Environment=COMPOSE_PROFILES=harness,orchestrator
Environment=SOPS_AGE_KEY_FILE=/opt/optio-new/secrets/age/key.txt
ExecStart=/opt/optio-new/scripts/secrets.sh compose up -d
ExecStop=/usr/bin/docker compose -f /opt/optio-new/docker-compose.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
