{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "src/jev-mcp/**/*.ts",
    "gateway/jev-router/**/*.ts",
    "src/orchestrator/telemetry/**/*.ts",
    "src/security/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "tests"]
}
