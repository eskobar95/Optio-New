# Optio-New IP HTTP edge (SPEC §12.5). Safe to commit: no hostname, mailbox, or secret.
# Compose profile `edge`. Catch-all on :80 for the kit-harness host public IP.
# Let's Encrypt cannot issue for a bare IP. HTTP only until a real domain exists.
# Domain + TLS is a later swap of this file. See docs/ops/caddy-tls-edge.md.
# Local/dev intake stays loopback HTTP on 127.0.0.1:3100.
{
	auto_https off
}

:80 {
	handle /healthz {
		respond "ok" 200
	}

	# Signed intake only. Do not add a route for POST /intake.
	handle /webhooks/* {
		reverse_proxy orchestrator:3100
	}

	handle {
		respond "not found" 404
	}
}
